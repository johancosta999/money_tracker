# Copy to .env and fill in. Never commit the real .env.

PORT=5000

# Required
MONGO_URI=
# Long random value (32+ characters)
JWT_SECRET=

# Site that password-reset links open (no trailing slash)
FRONTEND_URL=http://localhost:5173

# Optional: forgot-password emails (free account at resend.com).
# Without a key, reset emails are skipped and logged.
RESEND_API_KEY=
# Until you verify a domain in Resend, leave this empty: the shared test sender
# can only deliver to the email address of your own Resend account.
RESEND_FROM=

# Optional: error monitoring (free project at sentry.io)
SENTRY_DSN=
